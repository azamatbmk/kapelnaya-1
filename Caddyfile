{
	auto_https off
}

:8080 {
	root * /srv
	encode gzip zstd
	respond /healthz 200

	# После регистрации домена раскомментируйте и подставьте имя:
	# @www host www.kapelnaya1.ru
	# redir @www https://kapelnaya1.ru{uri} permanent

	redir /index.html / permanent
	@nestedIndex path_regexp nested ^(.+)/index\.html$
	redir @nestedIndex {re.nested.1}/ permanent

	@noSlash {
		not path */
		not path /
		not path *.*
	}
	redir @noSlash {path}/ 308

	try_files {path} {path}/ =404
	file_server

	handle_errors {
		@404 {
			expression {err.status_code} == 404
		}
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
