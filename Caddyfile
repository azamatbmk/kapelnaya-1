{
	auto_https off
}

:8080 {
	root * /srv
	encode gzip zstd

	handle /healthz {
		respond 200
	}

	handle {
		redir /index.html / permanent
		@nestedIndex path_regexp nested ^(.+)/index\.html$
		redir @nestedIndex {re.nested.1}/ permanent

		@noSlash {
			not path */
			not path /
			not path *.*
		}
		redir @noSlash {path}/ 308

		# try_files превращает «/» в «//index.html» и не находит главную
		rewrite / /index.html
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors {
		@404 {
			expression {err.status_code} == 404
		}
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
